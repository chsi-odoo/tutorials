<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="demo_estate_property_offer_1" model="estate.property.offer">
            <field name="partner_id" ref="base.res_partner_12"/>
            <field name="property_id" ref="estate.demo_estate_property_1"/>
            <field name="price">10000</field>
            <field name="create_date" eval="datetime.now()"/>

            <field name="validity">14</field>
<!--            <field name="status">refused</field>-->
        </record>

        <record id="demo_estate_property_offer_2" model="estate.property.offer">
            <field name="partner_id" ref="base.res_partner_12"/>
            <field name="property_id" ref="estate.demo_estate_property_1"/>
            <field name="price">1500000</field>
            <field name="create_date" eval="datetime.now()"/>
            <field name="validity">14</field>
<!--            <field name="status">refused</field>-->
        </record>

        <record id="demo_estate_property_offer_3" model="estate.property.offer">
            <field name="partner_id" ref="base.res_partner_2"/>
            <field name="property_id" ref="estate.demo_estate_property_1"/>
            <field name="price">1500001</field>
            <field name="create_date" eval="datetime.now()"/>
            <field name="validity">14</field>
<!--            <field name="status">accepted</field>-->
        </record>

        <function model="estate.property.offer" name="action_accept">
            <value eval="[ref('demo_estate_property_offer_3')]"/>
        </function>

        <function model="estate.property.offer" name="action_refuse">
            <value eval="[ref('demo_estate_property_offer_1')]"/>
        </function>

        <function model="estate.property.offer" name="action_refuse">
            <value eval="[ref('demo_estate_property_offer_2')]"/>
        </function>

    </data>
</odoo>