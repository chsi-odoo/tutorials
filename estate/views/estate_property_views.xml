<?xml version="1.0"?>
<odoo>
    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" groups_draggable="False" records_draggable="False">
                <templates>

                    <t t-name="kanban-box">
                        <div>
                            <!-- it works when u add it after the server is started up tho with the dev xml refresh thingy-->
<!--                            <div><t t-log="record"/></div>-->
<!--                            <t t-js="ctx">-->
<!--                                console.log(record);-->
<!--                            </t>-->
                            <field name="state" invisible="1"/>

                            <div>
                                <b>
                                    <field name="name"/>
                                </b>
                            </div>

                            <t t-if="record.state">
                                <div>
                                    <span>Expected price: </span>
                                    <field name="expected_price"/>
                                </div>
                            </t>
                            <t t-if="record.state.raw_value == 'offer_received'">
                                <div>
                                    <span>Best price: </span>
                                    <field name="best_price"/>
                                </div>
                            </t>
                            <!--                            why is this not working-->
                            <!--                            <t t-if="record.state in ['offer_accepted', 'sold']"-->
                            <t t-if="record.state.raw_value == 'offer_accepted' or record.state == 'sold'">
                                <div>
                                    <span>Selling price: </span>
                                    <field name="selling_price"/>
                                </div>
                            </t>
                            <field name="tag_ids" options="{'color_field': 'color'}"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="i do not see this being displayed anywhere">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area','&gt;=',self)]"/>
                <field name="facades"/>
                <field name="property_type_id"/>

                <filter string="Available Properties" name='available_filter'
                        domain="['|',('state','=','offer_received'),('state','=','new')]"/>

                <filter string="By postcode" name="postcode" context="{'group_by': 'postcode'}"/>
            </search>
        </field>
    </record>
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Test">
                <header>
                    <group>
                        <button name="action_set_state_sold" string="Sold" type="object"
                                invisible="state == 'offer_accepted' or state == 'cancelled' or state == 'sold'"/>
                        <button name="action_set_state_sold" string="Sold" type="object" class="oe_highlight"
                                invisible="state == 'new' or state == 'offer_received' or state == 'cancelled' or state == 'sold'"/>
                        <button name="action_set_state_cancelled" string="Cancel" type="object" class="oe_highlight"
                                invisible="state == 'cancelled' or state == 'sold'"/>
                    </group>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <!--                    smart buttons? -->
                    <!--                    <div class="oe_button_box" name="button_box">-->
                    <!--                        <button name="action_lost_leads" type="object"-->
                    <!--                                class="oe_stat_button" icon="fa-star">-->
                    <!--                            <div class="o_stat_info">-->
                    <!--                                <field name="description" class="o_stat_value"/>-->
                    <!--                                <span class="o_stat_text">Leads</span>-->
                    <!--                            </div>-->
                    <!--                        </button>-->
                    <!--                    </div>-->

                    <group>
                        <div class="oe_title">
                            <h1>
                                <field name="name"></field>
                            </h1>
                        </div>

                    </group>

                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                    <group>
                        <group>
                            <!--                            <field name="state"/>-->
                            <field name="property_type_id" options="{'no_create': True}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" string="Garden Area (sqm)" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="property_type_id"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids"
                                   readonly="state == 'offer_accepted' or state == 'sold' or state == 'cancelled'"/>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesperson_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Channel" decoration-success="state == 'offer_accepted' or state == 'offer_received'"
                  decoration-bf="state == 'offer_accepted'" decoration-muted="state == 'sold'">
                <!--                <list string="Channel">-->
                <!--                <field name="state"/>-->
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="hide"/>
                <field name="tag_ids"/>
                <field name="property_type_id"/>
            </list>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate property action</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{"search_default_available_filter":1}</field>
    </record>

