<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_res_partners_core">
        <div class="page">
            <table class="table">
                <thead>
                    <td>Name</td>
                    <td>Email</td>
                </thead>
                <tbody>
                    <tr t-foreach="partners" t-as="partner">
                       <td>
                           <span t-field="partner.name"/>
                       </td>
                        <td>
                            <span t-field="partner.email"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="report_res_partners">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="partners" t-value="docs"/>
                <t t-call="better_report.report_res_partners_core"/>
            </t>
        </t>
    </template>
</odoo>