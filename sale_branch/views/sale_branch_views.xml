<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="sale_branch_view_search" model="ir.ui.view">
            <field name="name">sale.branch.view.search</field>
            <field name="model">sale.branch</field>
            <field name="arch" type="xml">
                <search string="i do not see this being displayed anywhere">
                    <field name="name"/>
                    <field name="code" />
                </search>
            </field>
        </record>

        <record id="sale_branch_view_form" model="ir.ui.view">
            <field name="name">sale.branch.view.form</field>
            <field name="model">sale.branch</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="sale_branch_view_list" model="ir.ui.view">
            <field name="name">sale.branch.view.list</field>
            <field name="model">sale.branch</field>
            <field name="arch" type="xml">

                <list>
                    <field name="name"/>
                    <field name="code" readonly="id"/>
                </list>

            </field>
        </record>

        <record id="sale_branch_action" model="ir.actions.act_window">
            <field name="name">Sales Branches</field>
            <field name="res_model">sale.branch</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>